include "rtpParameters.fbs";
include "rtxStream.fbs";

namespace FBS.RtpStream;

table Params {
    encoding_idx: uint32;
    ssrc: uint32;
    payload_type: uint8;
    mime_type: string (required);
    clock_rate: uint32;
    rid: string;
    cname: string (required);
    rtx_ssrc: uint32 = null;
    rtx_payload_type: uint8 = null;
    use_nack: bool;
    use_pli: bool;
    use_fir: bool;
    use_in_band_fec: bool;
    use_dtx: bool;
    spatial_layers: uint8;
    temporal_layers: uint8;
}

table Dump {
    params: Params (required);
    score: uint8;
    rtx_stream: FBS.RtxStream.RtxDump;
}

table BitrateByLayer {
    layer: string (required);
    bitrate: uint32;
}

union StatsData {
    BaseStats,
    RecvStats,
    SendStats,
}

table Stats {
    data: StatsData (required);
}

table BaseStats {
    timestamp: uint64;
    ssrc: uint32;
    kind: FBS.RtpParameters.MediaKind;
    mime_type: string (required);
    packets_lost: uint64;
    fraction_lost: uint8;
    packets_discarded: uint64;
    packets_retransmitted: uint64;
    packets_repaired: uint64;
    nack_count: uint64;
    nack_packet_count: uint64;
    pli_count: uint64;
    fir_count: uint64;
    score: uint8;
    instant_score: uint8 = 10;
    instant_loss_ratio: float;
    instant_rtt_ms: float;
    rid: string;
    rtx_ssrc: uint32 = null;
    rtx_packets_discarded: uint64;
    round_trip_time: float;
    abs_capture_timestamp_ntp: uint64 = null;
    estimated_capture_clock_offset: int64 = null;
    abs_capture_timestamp_ms: uint64 = null;
    estimated_capture_clock_offset_ms: int64 = null;
    abs_capture_receive_delta_ms: int64 = null;
    rtt_updated_at_ms: uint64;
    score_updated_at_ms: uint64;
    rtcp_loss_window_start_ms: uint64;
    rtcp_loss_window_end_ms: uint64;
    rtcp_expected_packets: uint64;
    rtcp_received_packets: uint64;
    rtcp_lost_packets: uint64;
    newly_missing_packets: uint64;
    repaired_packets: uint64;
    retransmitted_packets: uint64;
    unrecovered_packets: uint64;
}

table RecvStats {
    base: Stats (required);
    jitter: uint32;
    packet_count: uint64;
    byte_count: uint64;
    bitrate: uint32;
    bitrate_by_layer: [BitrateByLayer] (required);
    rtp_active: bool = true;
    last_rtp_activity_at_ms: uint64;
    rtp_activity_threshold_ms: uint32;
    rtp_activity_state_version: uint64;
    jitter_updated_at_ms: uint64;
    reported_bitrate_window_ms: uint32;
}

table SendStats {
    base: Stats (required);
    packet_count: uint64;
    byte_count: uint64;
    bitrate: uint32;
    reported_bitrate_window_ms: uint32;
}
